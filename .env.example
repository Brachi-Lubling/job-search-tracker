# PostgreSQL (matches docker-compose.yml)
# Host port 5544 avoids clashing with a native Postgres on 5432
DATABASE_URL="postgresql://cvuser:CHANGE_ME@localhost:5544/cvplatform?schema=public"
POSTGRES_PASSWORD="CHANGE_ME"

# Base URL used by Server Components to call the app's own API
APP_URL="http://localhost:3000"

# Local file uploads (resume PDFs) — under public/ so Next serves them at /uploads
UPLOAD_DIR="./public/uploads"
